---
import { basics, projects, technicalSkills, work } from "@cv";

const currentRole = work.find((job) => job.endDate === null);
const projectNames = projects.map((project) => project.name).join(", ");
const skillNames = technicalSkills.map((skill) => skill.name).join(", ");
---

<div
  class="chatbot no-print"
  data-chatbot
  data-name={basics.name}
  data-label={basics.label}
  data-email={basics.email}
  data-phone={basics.phone}
  data-projects={projectNames}
  data-skills={skillNames}
  data-current-role={currentRole ? `${currentRole.position} at ${currentRole.name}` : ""}
>
  <button
    class="chatbot-launcher"
    type="button"
    data-chatbot-toggle
    aria-expanded="false"
    aria-controls="portfolio-chatbot-panel"
  >
    <span class="chatbot-launcher-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M7.5 18.25 4 20l1.2-3.6A8 8 0 0 1 4 11.5C4 7.36 7.58 4 12 4s8 3.36 8 7.5-3.58 7.5-8 7.5c-1.64 0-3.17-.46-4.5-1.25Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <path
          d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span class="chatbot-launcher-text">Ask about me</span>
  </button>

  <section
    id="portfolio-chatbot-panel"
    class="chatbot-panel"
    data-chatbot-panel
    aria-label="Portfolio assistant"
    hidden
  >
    <header class="chatbot-header">
      <div>
        <p class="chatbot-kicker">PORTFOLIO ASSISTANT</p>
        <h2>Ask about {basics.name.split(" ").slice(-2).join(" ")}</h2>
      </div>
      <button
        class="chatbot-close"
        type="button"
        data-chatbot-close
        aria-label="Close portfolio assistant"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </header>

    <div
      class="chatbot-messages"
      data-chatbot-messages
      role="log"
      aria-live="polite"
      aria-label="Chat messages"
    ></div>

    <div class="chatbot-suggestions" data-chatbot-suggestions>
      <button type="button" data-chatbot-question="What does he specialize in?">
        Specialization
      </button>
      <button type="button" data-chatbot-question="What projects has he built?">
        Projects
      </button>
      <button type="button" data-chatbot-question="What are his strongest skills?">
        Skills
      </button>
      <button type="button" data-chatbot-question="How can I contact him?">
        Contact
      </button>
    </div>

    <form class="chatbot-form" data-chatbot-form>
      <label class="sr-only" for="chatbot-question">Ask a question</label>
      <input
        id="chatbot-question"
        data-chatbot-input
        type="text"
        placeholder="Ask about experience, skills..."
        autocomplete="off"
        maxlength="300"
      />
      <button type="submit" aria-label="Send question">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="m5 12 14-7-4.5 14-3-6-6.5-1Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path
            d="m11.5 13 3.5-3.5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </form>

  </section>
</div>

<script>
  type ChatRole = "assistant" | "user";

  const chatbot = document.querySelector<HTMLElement>("[data-chatbot]");

  if (chatbot) {
    const toggle = chatbot.querySelector<HTMLButtonElement>("[data-chatbot-toggle]");
    const close = chatbot.querySelector<HTMLButtonElement>("[data-chatbot-close]");
    const panel = chatbot.querySelector<HTMLElement>("[data-chatbot-panel]");
    const messages = chatbot.querySelector<HTMLElement>("[data-chatbot-messages]");
    const form = chatbot.querySelector<HTMLFormElement>("[data-chatbot-form]");
    const input = chatbot.querySelector<HTMLInputElement>("[data-chatbot-input]");
    const suggestions = chatbot.querySelector<HTMLElement>("[data-chatbot-suggestions]");

    const normalize = (value: string) =>
      value
        .toLocaleLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/đ/g, "d");

    const hasAny = (value: string, words: string[]) =>
      words.some((word) => value.includes(word));

    const profile = {
      name: chatbot.dataset.name ?? "the developer",
      label: chatbot.dataset.label ?? ".NET Software Engineer",
      email: chatbot.dataset.email ?? "",
      phone: chatbot.dataset.phone ?? "",
      projects: chatbot.dataset.projects ?? "",
      skills: chatbot.dataset.skills ?? "",
      currentRole: chatbot.dataset.currentRole ?? "",
    };

    const addMessage = (text: string, role: ChatRole) => {
      if (!messages) return;

      const wrapper = document.createElement("div");
      wrapper.className = `chatbot-message chatbot-message-${role}`;

      const bubble = document.createElement("p");
      bubble.textContent = text;
      bubble.className = "chatbot-bubble";
      wrapper.appendChild(bubble);
      messages.appendChild(wrapper);
      messages.scrollTop = messages.scrollHeight;
    };

    const getLocalReply = (question: string) => {
      const value = normalize(question);

      if (hasAny(value, ["hello", "hi", "hey", "xin chao", "chao"])) {
        return `Hi! I can share information about ${profile.name}'s experience, skills, projects, and contact details.`;
      }

      if (hasAny(value, ["contact", "email", "phone", "lien he", "so dien thoai", "mail"])) {
        return `You can contact ${profile.name} at ${profile.email} or ${profile.phone}.`;
      }

      if (hasAny(value, ["skill", "technology", "tech stack", "ky nang", "cong nghe", "strongest"])) {
        return `The main skills listed are ${profile.skills}.`;
      }

      if (hasAny(value, ["specialize", "specialization", "expertise", "chuyen mon", "gioi thieu"])) {
        return `${profile.name} is a ${profile.label} focused on backend development with ASP.NET Core, scalable APIs, SQL, integrations, and production delivery.`;
      }

      if (hasAny(value, ["project", "du an", "built", "portfolio"])) {
        return `The portfolio includes ${profile.projects}. Ask about a specific project to learn more.`;
      }

      if (hasAny(value, ["experience", "work", "career", "kinh nghiem", "lam viec"])) {
        return `${profile.name} is currently ${profile.currentRole}. The experience includes ASP.NET Core APIs, database optimization, integrations, CI/CD, and production support.`;
      }

      if (hasAny(value, ["semantic kernel", "sqlitevec", "backend", "chatbot"])) {
        return "This chat is currently a local UI preview. The next step is to connect it to an ASP.NET Core Semantic Kernel backend with SQLiteVec search.";
      }

      return "I can answer questions about experience, skills, projects, specialization, or contact details. Try one of the quick questions below.";
    };

    const setOpen = (open: boolean) => {
      if (!panel || !toggle) return;

      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));

      if (open) {
        window.setTimeout(() => input?.focus(), 50);
      }
    };

    toggle?.addEventListener("click", () => {
      setOpen(panel?.hidden ?? true);
    });

    close?.addEventListener("click", () => setOpen(false));

    document.addEventListener("click", (event) => {
      const target = event.target as Node | null;

      if (target && !chatbot.contains(target)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
      }
    });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const question = input?.value.trim() ?? "";
      if (!question) return;

      addMessage(question, "user");
      if (input) input.value = "";

      window.setTimeout(() => addMessage(getLocalReply(question), "assistant"), 180);
    });

    suggestions?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-chatbot-question]",
      );
      const question = button?.dataset.chatbotQuestion;

      if (!question || !input || !form) return;

      input.value = question;
      form.requestSubmit();
    });

    addMessage(
      `Hi! I'm a local preview assistant for ${profile.name}. Ask me about experience, skills, projects, or contact details.`,
      "assistant",
    );
  }
</script>

<style>
  .chatbot {
    @apply fixed bottom-6 right-4 z-50;
  }

  .chatbot-launcher {
    @apply inline-flex cursor-pointer items-center gap-2 rounded-full bg-skin-hue px-4 py-3 text-sm font-extrabold text-white shadow-xl shadow-skin-hue/25 transition hover:-translate-y-0.5 hover:bg-skin-button-accent focus:outline-none focus:ring-4 focus:ring-skin-hue/30;
  }

  .chatbot-launcher-icon {
    @apply inline-flex size-5;
  }

  .chatbot-launcher-icon svg,
  .chatbot-close svg,
  .chatbot-form button svg {
    @apply size-full;
  }

  .chatbot-panel {
    @apply absolute bottom-16 right-0 flex h-[min(72vh,590px)] w-[min(92vw,390px)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/20 dark:border-slate-700 dark:bg-slate-950 dark:shadow-black/50;
  }

  .chatbot-panel[hidden] {
    display: none;
  }

  .chatbot-header {
    @apply flex items-start justify-between gap-4 border-b border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-900;
  }

  .chatbot-kicker {
    @apply text-[10px] font-black tracking-[0.16em] text-skin-hue;
  }

  .chatbot-header h2 {
    @apply mt-1 text-lg font-black text-slate-900 dark:text-white;
  }

  .chatbot-close {
    @apply inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-skin-hue/40 dark:hover:bg-slate-800 dark:hover:text-white;
  }

  .chatbot-close svg {
    @apply size-4;
  }

  .chatbot-messages {
    @apply flex flex-1 flex-col gap-3 overflow-y-auto bg-white px-4 py-4 dark:bg-slate-950;
  }

  :global(.chatbot-message) {
    @apply flex;
  }

  :global(.chatbot-message-assistant) {
    @apply justify-start;
  }

  :global(.chatbot-message-user) {
    @apply justify-end;
  }

  :global(.chatbot-bubble) {
    @apply m-0 max-w-[88%] whitespace-pre-line rounded-2xl rounded-bl-md border border-slate-200 bg-slate-100 px-3.5 py-2.5 text-sm font-semibold leading-6 text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200;
  }

  :global(.chatbot-message-user .chatbot-bubble) {
    @apply rounded-bl-2xl rounded-br-md border-skin-hue bg-skin-hue text-white;
  }

  .chatbot-suggestions {
    @apply flex gap-2 overflow-x-auto border-t border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-950;
  }

  .chatbot-suggestions button {
    @apply shrink-0 cursor-pointer rounded-full border border-skin-hue/40 bg-skin-button-accent/10 px-3 py-1.5 text-xs font-extrabold text-skin-hue transition hover:bg-skin-button-accent/20 focus:outline-none focus:ring-2 focus:ring-skin-hue/30;
  }

  .chatbot-form {
    @apply flex items-center gap-2 border-t border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-950;
  }

  .chatbot-form input {
    @apply min-w-0 flex-1 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-slate-800 outline-none placeholder:text-slate-400 focus:border-skin-hue focus:ring-2 focus:ring-skin-hue/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100;
  }

  .chatbot-form button {
    @apply inline-flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-xl bg-skin-hue text-white transition hover:bg-skin-button-accent focus:outline-none focus:ring-2 focus:ring-skin-hue/40;
  }

  .chatbot-form button svg {
    @apply size-5;
  }

  @media (width <= 640px) {
    .chatbot {
      @apply bottom-6 right-3;
    }

    .chatbot-launcher {
      @apply size-12 justify-center p-0;
    }

    .chatbot-launcher-text {
      @apply hidden;
    }

    .chatbot-panel {
      right: 0;
      @apply w-[calc(100vw-1.5rem)];
    }
  }
</style>
