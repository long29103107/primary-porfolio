---
import Section from "../Section.astro";
import { work } from "@cv";
import ASPNETCore from "@/icons/ASPNETCore.astro";
import RabbitMQ from "@/icons/RabbitMQ.astro";
import SQLServer from "@/icons/SQLServer.astro";
import EntityFramework from "@/icons/EntityFramework.astro";
import gRPC from "@/icons/gRPC.astro";
import CSharp from "@/icons/CSharp.astro";
import Jenkins from "@/icons/Jenkins.astro";
import GitHub from "@/icons/GitHub.astro";

const SKILL_ICONS: Record<string, any> = {
  "ASP.NET Core API": ASPNETCore,
  "ASP.NET Core": ASPNETCore,
  ".NET Core": ASPNETCore,
  RabbitMQ,
  "SQL Server": SQLServer,
  "Entity Framework": EntityFramework,
  "Entity Framework Core": EntityFramework,
  gRPC,
  "C#": CSharp,
  Jenkins,
  GitHub,
};

function formatMonthYear(date: string | null) {
  if (!date) return "Present";

  return new Intl.DateTimeFormat("en", {
    month: "short",
    year: "numeric",
  }).format(new Date(date));
}

const companies = work.reduce(
  (items, job) => {
    const existing = items.find((item) => item.name === job.name);
    const responsibilities = job.responsibilities ?? [];
    const achievements = job.achievements ?? [];
    const highlights = job.highlights ?? [];
    const skills = job.skills ?? [];

    if (existing) {
      existing.startDate = job.startDate < existing.startDate ? job.startDate : existing.startDate;
      existing.endDate =
        job.endDate === null || existing.endDate === null
          ? null
          : job.endDate > existing.endDate
            ? job.endDate
            : existing.endDate;
      existing.roles.push(job.position);
      existing.responsibilities.push(...responsibilities);
      existing.achievements.push(...achievements);
      existing.highlights.push(...highlights);
      existing.skills.push(...skills);
      return items;
    }

    items.push({
      name: job.name,
      url: job.url,
      location: job.location,
      location_type: job.location_type,
      startDate: job.startDate,
      endDate: job.endDate,
      roles: [job.position],
      responsibilities: [...responsibilities],
      achievements: [...achievements],
      highlights: [...highlights],
      skills: [...skills],
    });

    return items;
  },
  [] as Array<{
    name: string;
    url?: string;
    location?: string;
    location_type?: string;
    startDate: string;
    endDate: string | null;
    roles: string[];
    responsibilities: string[];
    achievements: string[];
    highlights: string[];
    skills: string[];
  }>,
);

const sortedCompanies = companies.sort((a, b) => Number(new Date(b.startDate)) - Number(new Date(a.startDate)));
---

<Section className={["career-section", Astro.props.className].filter(Boolean).join(" ")} title="Career Journey">
  <ul class="career-timeline flex flex-col">
    {
      sortedCompanies.map((company) => {
        const dates = `${formatMonthYear(company.startDate)} - ${formatMonthYear(company.endDate)}`;
        const uniqueRoles = [...new Set(company.roles)];
        const uniqueResponsibilities = [...new Set(company.responsibilities)].slice(0, 7);
        const uniqueAchievements = [...new Set(company.achievements)].slice(0, 5);
        const uniqueHighlights = [...new Set(company.highlights)].slice(0, 4);
        const uniqueSkills = [...new Set(company.skills)].slice(0, 14);

        return (
          <li class="relative print:py-2">
            <article class="relative grid print:grid-cols-1 print:gap-1">
              <div class="timeline-body relative flex flex-col pb-10">
                <time class="mb-3 text-sm font-extrabold text-skin-base" datetime={company.startDate}>
                  {dates}
                </time>
                <h3 class="text-2xl font-black leading-tight print:text-base">
                  <span>{uniqueRoles[0]}</span>
                  <span class="text-skin-muted"> @ </span>
                  {company.url ? (
                    <a class="group/link inline-flex items-center gap-1 text-skin-hue hover:text-skin-hue-hover" href={company.url} title={`Visit ${company.name}`} target="_blank">
                      {company.name}
                      <svg class="size-4 transition-transform group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                      </svg>
                    </a>
                  ) : (
                    <span>{company.name}</span>
                  )}
                </h3>

                <p class="mt-3 text-sm font-bold text-skin-muted">
                  {company.location_type}
                  {company.location_type && company.location && " - "}
                  {company.location}
                </p>

                <div class="career-detail mt-8">
                  {uniqueResponsibilities.length > 0 && (
                    <div>
                      <h4>Responsibilities</h4>
                      <ul class="career-list">
                        {uniqueResponsibilities.map((responsibility) => (
                          <li set:html={responsibility} />
                        ))}
                      </ul>
                    </div>
                  )}

                  {uniqueAchievements.length > 0 && (
                    <div>
                      <h4>Achievements</h4>
                      <ul class="career-list">
                        {uniqueAchievements.map((achievement) => (
                          <li set:html={achievement} />
                        ))}
                      </ul>
                    </div>
                  )}

                  {uniqueHighlights.length > 0 && (
                    <div>
                      <h4>Highlights</h4>
                      <ul class="career-list">
                        {uniqueHighlights.map((highlight) => (
                          <li set:html={highlight} />
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                {uniqueSkills.length > 0 && (
                  <div class="mt-6 print:hidden">
                    <h4 class="mb-3 text-base font-black text-skin-base">Tools &amp; platforms I use:</h4>
                    <ul class="flex flex-wrap gap-2">
                      {uniqueSkills.map((skill) => {
                        const Icon = SKILL_ICONS[skill];

                        return (
                          <li class="tool-chip">
                            {Icon ? (
                              <Icon />
                            ) : (
                              <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            )}
                            <span>{skill}</span>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  :global(.career-section > div:first-child h3) {
    @apply text-xl font-black leading-none;
  }

  .timeline-body {
    @apply border-l-2 border-slate-300 pl-7 dark:border-slate-500 print:border-l-0 print:pl-0;
    border-left: 2px solid rgb(148 163 184) !important;
  }

  .timeline-body::before {
    @apply absolute -left-[6px] top-[10px] size-2.5 rounded-full bg-slate-400 ring-4 ring-white content-[''] dark:bg-slate-500 dark:ring-skin-fill print:hidden;
    background: rgb(100 116 139) !important;
  }

  :global(.dark) .timeline-body {
    border-left-color: rgb(100 116 139) !important;
  }

  .career-detail {
    @apply grid max-w-3xl gap-6;
  }

  .career-detail h4 {
    @apply mb-3 text-base font-black text-skin-base;
  }

  .career-list {
    @apply ml-5 list-disc space-y-3 text-base font-semibold leading-7 text-skin-base;
  }

  .career-list li::marker {
    @apply text-skin-hue;
  }

  .tool-chip {
    @apply inline-flex min-h-7 items-center gap-1.5 rounded-md border border-skin-hue/75 bg-skin-button-accent/10 px-3 py-1 text-xs font-extrabold text-skin-hue shadow-sm shadow-skin-hue/5 dark:bg-skin-button-muted;
  }

  .tool-chip :global(svg) {
    @apply size-4 shrink-0;
  }

  @media (width <= 768px) {
    .timeline-body {
      @apply ml-2 pl-6;
    }
  }
</style>
