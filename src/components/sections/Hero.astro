---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { SocialIcon } from "@/types";

const { name, label, image, location, profiles, phone, email, url } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;
const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" | ");
---

<Section>
  <div class="flex flex-col gap-8">
    <figure class="relative mx-auto w-fit print:hidden">
      <div
        class="absolute -left-12 -top-8 size-full rounded-full bg-skin-button-accent/20 dark:bg-skin-button-muted"
      >
      </div>
      <img class="relative z-10 shadow-lg shadow-slate-900/10" src={image} alt={name} />
    </figure>

    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <div class="flex items-center gap-2 pt-2 text-sm text-skin-muted">
        <WorldMap />
        {city}, {region}
      </div>

      <footer class="print">{printInfo}</footer>
      <footer class="no-print contact-list" aria-label="Contact links">
        {
          email && (
            <a href={`mailto:${email}`} title={`Email ${name} at ${email}`} aria-label={`Email ${name}`}>
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a href={`tel:${phone}`} title={`Call ${name} at ${phone}`} aria-label={`Call ${name}`}>
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];

            return (
              Icon && (
                <a href={url} title={`Visit ${name} profile on ${network}`} aria-label={`Visit ${network}`} target="_blank" rel="noopener noreferrer">
                  <Icon />
                </a>
              )
            );
          })
        }
        {
          url && (
            <a href={url} title={`Visit ${name} website`} aria-label={`Visit ${name} website`} target="_blank" rel="noopener noreferrer">
              <WorldMap />
            </a>
          )
        }
      </footer>
    </div>
  </div>
</Section>

<style>
  .info {
    @apply flex flex-col gap-2 print:gap-0;
  }

  h1 {
    @apply text-4xl font-black uppercase leading-none print:text-3xl;
  }

  h2 {
    @apply text-balance text-lg font-bold text-skin-muted print:text-lg;
  }

  img {
    @apply aspect-square w-36 rounded-full object-cover sm:w-40;
  }

  .contact-list {
    @apply mt-3 flex flex-row flex-wrap items-center gap-2 text-sm;
  }

  .contact-list a {
    @apply inline-flex size-9 items-center justify-center rounded-full text-skin-hue transition-all duration-300 hover:bg-skin-button-accent/15 hover:text-skin-hue-hover;
  }

  .contact-list a :global(svg),
  .info > div :global(svg) {
    @apply size-5 shrink-0 text-skin-hue;
  }
</style>

<script>
  const themeSwitch = document.getElementById("themeSwitch") as HTMLInputElement | null;

  window.addEventListener("beforeprint", () => {
    document.documentElement.classList.remove("dark");
  });

  window.addEventListener("afterprint", () => {
    if (themeSwitch?.checked) {
      document.documentElement.classList.add("dark");
    }
  });
</script>
