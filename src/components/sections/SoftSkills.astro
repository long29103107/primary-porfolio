---
import Section from "../Section.astro";
import { softSkills } from "@cv";
---

<Section className={Astro.props.className} title="Soft Skills">
	<ul class="inline-flex flex-wrap gap-2 [&>li]:text-sm">
		{
			softSkills.length > 0 && softSkills.map((softSkill) => {
				return (
					<li class="flex min-h-7 items-center gap-1 rounded-full bg-skin-button-accent/10 px-3 py-1 text-xs font-extrabold text-skin-hue print:border-none print:bg-transparent print:p-0 print:text-zinc-800 dark:bg-skin-button-muted">
						<span>{softSkill}</span>
					</li>
				);
			})
		}
	</ul>
</Section>
