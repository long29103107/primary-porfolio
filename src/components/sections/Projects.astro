---
import Git from "@/icons/git.astro";
import Arrow from "@/icons/Arrow.astro";
import Section from "../Section.astro";

import { projects, work } from "@cv";

const workProjects = work.map((job) => ({
  name: job.summary?.match(/<b>(.*?)<\/b>/)?.[1] ?? job.name,
  company: job.name,
  url: job.url,
  description: job.summary,
  highlights: job.achievements ?? job.highlights ?? [],
  skills: job.skills ?? [],
}));
---

<Section className={Astro.props.className} title="Projects">
  <div class="grid gap-8">
    <div class="project-column">
      <h4>Work Projects</h4>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          workProjects.map(({ name, company, url, description, highlights, skills }) => (
            <article class="project-card">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h5>
                    {url ? (
                      <a class="group inline-flex items-center gap-1 text-skin-hue hover:text-skin-hue-hover" href={url} title={`View ${company}`} target="_blank">
                        {name}
                        <span class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                          <Arrow />
                        </span>
                      </a>
                    ) : (
                      name
                    )}
                  </h5>
                  <p class="text-xs font-bold text-skin-muted">{company}</p>
                </div>
              </div>

              <p class="py-3 text-sm text-skin-muted" set:html={description} />

              {highlights.length > 0 && (
                <ul class="project-list">
                  {highlights.slice(0, 3).map((highlight) => (
                    <li set:html={highlight} />
                  ))}
                </ul>
              )}

              {skills.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2">
                  {skills.slice(0, 6).map((skill) => (
                    <li class="skill-chip">{skill}</li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <div class="project-column">
      <h4>Personal Projects</h4>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          projects.map(({ url, description, highlights, name, isActive, github }) => (
            <article class="project-card">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 shrink-0 text-skin-hue"
                  >
                    <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                  </svg>
                  <h5>
                    {isActive ? (
                      <a class="group inline-flex items-center gap-1 text-skin-hue hover:text-skin-hue-hover" href={url} title={`View ${name}`} target="_blank">
                        {name}
                        <span class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                          <Arrow />
                        </span>
                      </a>
                    ) : (
                      <span>{name}</span>
                    )}
                  </h5>
                </div>

                {github && (
                  <a href={github} title={`View ${name} repository on GitHub`} target="_blank" rel="noopener" class="text-skin-muted opacity-75 transition hover:text-skin-hue hover:opacity-100">
                    <Git />
                  </a>
                )}
              </div>

              <p class="py-3 text-sm text-skin-muted">{description}</p>
              <ul class="project-list">
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</Section>

<style>
  .project-column {
    @apply grid content-start gap-4;
  }

  .project-column h4 {
    @apply text-base font-black text-skin-base;
  }

  .project-card {
    @apply relative flex flex-col rounded-lg border border-skin-muted bg-skin-button-muted/35 p-4 dark:bg-skin-button-muted/60;
  }

  .project-card h5 {
    @apply text-base font-black;
  }

  .project-list {
    @apply ml-4 list-disc space-y-1 text-sm text-skin-muted;
  }

  .project-list li::marker {
    @apply text-skin-hue;
  }

  .skill-chip {
    @apply inline-flex min-h-7 items-center rounded-full bg-skin-button-accent/10 px-3 py-1 text-xs font-extrabold text-skin-hue dark:bg-skin-button-muted;
  }
</style>
