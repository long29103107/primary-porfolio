---
import Arrow from "@/icons/Arrow.astro";
import Section from "../Section.astro";
import ASPNETCore from "@/icons/ASPNETCore.astro";
import CSharp from "@/icons/CSharp.astro";
import GitHub from "@/icons/GitHub.astro";
import React from "@/icons/react.astro";
import TypeScript from "@/icons/type.astro";
import RabbitMQ from "@/icons/RabbitMQ.astro";
import SQLServer from "@/icons/SQLServer.astro";
import EntityFramework from "@/icons/EntityFramework.astro";
import gRPC from "@/icons/gRPC.astro";
import Jenkins from "@/icons/Jenkins.astro";

import { projects, work } from "@cv";

const workProjects = work.map((job) => ({
  name: job.summary?.match(/<b>(.*?)<\/b>/)?.[1] ?? job.name,
  company: job.name,
  url: job.url,
  description: job.summary,
  highlights: job.achievements ?? job.highlights ?? [],
  skills: job.skills ?? [],
}));

const personalProjectSkillMap: Record<string, string[]> = {
  NETDevTool: ["ASP.NET Core", "OpenAPI", "Swagger", "JWT", "React", "LLM"],
  CachedRepository: [
    "C#",
    "Redis",
    "Scrutor",
    "Repository Pattern",
    "Unit of Work",
  ],
  "Portal Client": ["Bun", "React 19", "TypeScript", "Keycloak", "Dark Mode"],
  "GitOps Flow": [
    "GitHub Actions",
    "GHCR",
    "ArgoCD",
    "Helm",
    "Kubernetes",
    "Traefik",
  ],
};

const TAG_ICONS: Record<string, any> = {
  "ASP.NET Core": ASPNETCore,
  "ASP.NET Core API": ASPNETCore,
  "C#": CSharp,
  GitHub: GitHub,
  "GitHub Actions": GitHub,
  React,
  "React 19": React,
  TypeScript,
  RabbitMQ,
  "SQL Server": SQLServer,
  "Entity Framework": EntityFramework,
  "Entity Framework Core": EntityFramework,
  gRPC,
  Jenkins,
};

const type = Astro.props.type ?? "all";
const showWorkProjects = type === "all" || type === "work";
const showPersonalProjects = type === "all" || type === "personal";
---

<Section
  className={["projects-section", Astro.props.className]
    .filter(Boolean)
  .join(" ")}
>
  <div class="grid gap-8">
    {
      showWorkProjects && <div class="project-column">
      <h4>Work Projects</h4>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          workProjects.map(
            ({ name, company, url, description, highlights, skills }) => (
              <article class="project-card">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h5>
                      {url ? (
                        <a
                          class="group inline-flex items-center gap-1 text-skin-hue hover:text-skin-hue-hover"
                          href={url}
                          title={`View ${company}`}
                          target="_blank"
                        >
                          {name}
                          <span class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                            <Arrow />
                          </span>
                        </a>
                      ) : (
                        name
                      )}
                    </h5>
                    <p class="text-xs font-bold text-skin-muted">{company}</p>
                  </div>
                </div>

                <p
                  class="py-3 text-base font-semibold leading-7 text-skin-base"
                  set:html={description}
                />

                {highlights.length > 0 && (
                  <ul class="project-list">
                    {highlights.slice(0, 3).map((highlight) => (
                      <li set:html={highlight} />
                    ))}
                  </ul>
                )}

                {skills.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {skills.slice(0, 6).map((skill) => {
                      const Icon = TAG_ICONS[skill];

                      return (
                        <li class="skill-chip">
                          {Icon ? (
                            <Icon />
                          ) : (
                            <svg
                              class="size-4"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          )}
                          <span>{skill}</span>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </article>
            ),
          )
        }
      </div>
    </div>
    }

    {
      showPersonalProjects && <div class="project-column">
      <h4>Personal Projects</h4>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          projects.map(
            ({ url, description, highlights, name, isActive, github }) => (
              <article class="project-card">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-4 shrink-0 text-skin-hue"
                    >
                      <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                    </svg>
                    <h5>
                      {isActive ? (
                        <a
                          class="group inline-flex items-center gap-1 text-skin-hue hover:text-skin-hue-hover"
                          href={url}
                          title={`View ${name}`}
                          target="_blank"
                        >
                          {name}
                          <span class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                            <Arrow />
                          </span>
                        </a>
                      ) : (
                        <span>{name}</span>
                      )}
                    </h5>
                  </div>
                </div>

                <p class="py-3 text-base font-semibold leading-7 text-skin-base">
                  {description}
                </p>

                <ul class="project-list">
                  {highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>

                <ul class="mt-3 flex flex-wrap gap-2">
                  {(personalProjectSkillMap[name] ?? []).map((skill) => {
                    const Icon = TAG_ICONS[skill];

                    return (
                      <li class="project-tag">
                        {Icon ? (
                          <Icon />
                        ) : (
                          <svg
                            class="size-4"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path
                              d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        )}
                        <span>{skill}</span>
                      </li>
                    );
                  })}
                </ul>
              </article>
            ),
          )
        }
      </div>
    </div>
    }
  </div>
</Section>

<style>
  :global(.projects-section > div:first-child h3) {
    @apply text-3xl font-black leading-none;
  }

  .project-column {
    @apply grid content-start gap-4;
  }

  .project-column h4 {
    @apply text-xl font-black text-skin-base;
  }

  .project-card {
    @apply relative flex flex-col rounded-lg border border-slate-300/80 bg-skin-button-muted/20 p-5 shadow-sm shadow-slate-900/5 transition duration-300 ease-out hover:-translate-y-1 hover:border-skin-hue/70 hover:shadow-xl hover:shadow-skin-hue/10 dark:border-slate-700 dark:bg-skin-button-muted/30 dark:shadow-black/20;
  }

  .project-card h5 {
    @apply text-lg font-black;
  }

  .project-list {
    @apply ml-5 list-disc space-y-2 text-base font-semibold leading-7 text-skin-base;
  }

  .project-list li::marker {
    @apply text-skin-hue;
  }

  .skill-chip {
    @apply inline-flex min-h-7 items-center gap-1.5 rounded-full bg-skin-button-accent/10 px-3 py-1 text-xs font-extrabold text-skin-hue dark:bg-skin-button-muted;
  }

  .project-tag {
    @apply inline-flex min-h-7 items-center gap-1.5 rounded-full border border-skin-hue/40 bg-skin-button-accent/10 px-3 py-1 text-xs font-extrabold text-skin-hue dark:bg-skin-button-muted;
  }

  .skill-chip :global(svg),
  .project-tag :global(svg) {
    @apply size-4 shrink-0;
  }
</style>
