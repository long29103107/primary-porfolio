---
import Section from "../Section.astro";

import { basics } from "@cv";
const { summary } = basics;

const currentYear = new Date().getFullYear();
const yearsOfExperience = currentYear - 2022;

const processedSummary = summary.replace(
  /\{\{\s*yoe\s*\}\}/g,
  yearsOfExperience.toString(),
);
---

<Section className={Astro.props.className} title="About">
  <p class="text-base leading-7 text-skin-muted">
    {processedSummary}
  </p>
</Section>
