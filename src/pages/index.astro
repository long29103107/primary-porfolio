---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import TechnicalSkills from "@/components/sections/TechnicalSkills.astro";
import SoftSkills from "@/components/sections/SoftSkills.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";
import Projects from "@/components/sections/Projects.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";

import { basics } from "@cv";
const { name, label } = basics;
---

<Layout title={`${name} Portfolio - ${label}`}>
  <main
    class="resume-sheet relative grid max-w-7xl gap-12 p-8 pb-[0px] max-sm:py-16 md:grid-cols-6 md:p-16 md:pb-[10px] xl:gap-20 print:max-w-none print:grid-cols-1 print:gap-6 print:shadow-none"
  >
    <div
      class="no-print absolute right-4 top-4 z-10 flex items-center gap-1 md:right-6 md:top-6"
    >
      <ThemeSwitch />
    </div>

    <div
      class="space-y-8 max-md:contents md:col-span-2 print:col-span-1 print:grid print:grid-cols-2 print:gap-5 print:space-y-0"
    >
      <Hero className="max-md:order-1" />
      <TechnicalSkills className="max-md:order-3 print:hidden" />
      <SoftSkills className="max-md:order-4 print:hidden" />
      <Education className="max-md:order-5" />
    </div>
    <div
      class="space-y-10 max-md:contents md:col-span-4 print:col-span-1 print:grid print:grid-cols-4 print:gap-2 print:space-y-0"
    >
      <About className="order-first max-md:order-2" />
      <Experience className="max-md:order-6 print:col-span-3" />
    </div>
    <Projects type="work" className="col-span-full max-md:order-7 print:hidden" />
    <Projects
      type="personal"
      className="col-span-full max-md:order-8 print:hidden"
    />
    <p
      class="no-print col-span-full -mt-8 text-center text-xs leading-none text-skin-muted max-md:order-last xl:-mt-14"
    >
      1% better every day through learning. 📚✨
    </p>
  </main>

  <KeyboardManager />
</Layout>

<style>
  @page {
    size: auto;
    margin: 0mm;
  }
  main {
    margin: auto;
    width: 100%;
  }

  .resume-sheet {
    @apply bg-white shadow-2xl shadow-slate-900/10 dark:bg-skin-surface dark:shadow-black/30 md:my-12 md:rounded-lg print:bg-transparent;
  }
</style>

<script>
  document
    .querySelector("[data-print-button]")
    ?.addEventListener("click", () => {
      window.print();
    });
</script>
